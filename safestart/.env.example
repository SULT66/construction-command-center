POSTGRES_DB=safestart
POSTGRES_USER=safestart
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://safestart:change-me@postgres:5432/safestart

# Pilot user authentication only. Replace with InfraScan OIDC/SSO before production.
PILOT_TOKENS_JSON={}
REQUIRE_WORKFORCE_ELIGIBILITY=true

# Device bridge. Keys must be generated per device and stored as secrets.
DEVICE_HMAC_KEYS_JSON={}
DEVICE_MAX_CLOCK_SKEW_SEC=120
GUARDIAN_PRESENCE_TTL_SEC=90
EDGE_SYSTEM_ACTOR_ID=

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
OUTBOX_POLL_MS=2000
